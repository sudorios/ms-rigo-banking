              "raw": "{\n  \"transactionNumber\": \"TXN-0001\",\n  \"sourceProductId\": \"ID_CUENTA_ORIGEN\",\n  \"targetProductId\": \"ID_CUENTA_DESTINO\",\n  \"productType\": \"ACCOUNT\",\n  \"transactionType\": \"TRANSFER\",\n  \"amount\": 150.0,\n  \"fee\": 0.0\n}"
