  "item": [
    {
      "name": "01-Clientes",
      "item": [
        {
          "name": "1. Crear Cliente Personal Regular",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "http://localhost:8080/api/v1/customers", "host": ["http://localhost:8080/api/v1/customers"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentNumber\": \"76543210\",\n  \"documentType\": \"DNI\",\n  \"name\": \"Maria\",\n  \"lastName\": \"Gomez\",\n  \"customerType\": \"PERSONAL\",\n  \"profile\": \"REGULAR\"\n}"
            }
          }
        },
        {
          "name": "2. Crear Cliente VIP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "http://localhost:8080/api/v1/customers", "host": ["http://localhost:8080/api/v1/customers"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentNumber\": \"12345678\",\n  \"documentType\": \"DNI\",\n  \"name\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"customerType\": \"PERSONAL\",\n  \"profile\": \"VIP\"\n}"
            }
          }
        },
        {
          "name": "3. Obtener Clientes",
          "request": {
            "method": "GET",
            "url": {"raw": "http://localhost:8080/api/v1/customers", "host": ["http://localhost:8080/api/v1/customers"]}
          }
        }
      ]
    },
    {
      "name": "02-Cuentas",
      "item": [
        {
          "name": "1. Crear Cuenta Ahorro",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "http://localhost:8080/api/v1/bankaccounts", "host": ["http://localhost:8080/api/v1/bankaccounts"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"1000-2000-3000-4000\",\n  \"customerId\": \"ID_DEL_CLIENTE_AQUI\",\n  \"accountType\": \"SAVINGS\",\n  \"balance\": 500.0,\n  \"maintenanceFee\": 0.0,\n  \"maxMonthlyTransactions\": 5\n}"
            }
          }
        }
      ]
    },
    {
      "name": "03-Créditos",
      "item": [
        {
          "name": "1. Solicitar Tarjeta de Crédito",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "http://localhost:8080/api/v1/credits", "host": ["http://localhost:8080/api/v1/credits"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"creditNumber\": \"9999-8888-7777-6666\",\n  \"customerId\": \"ID_DEL_CLIENTE_AQUI\",\n  \"creditType\": \"CREDIT_CARD\",\n  \"limitAmount\": 2000.0,\n  \"hasOverdueDebt\": false\n}"
            }
          }
        }
      ]
    },
